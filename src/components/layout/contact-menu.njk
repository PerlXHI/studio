var TXT={en:{navShop:"Music",navGallery:"Portfolio",navCustom:"Custom",navLicense:"License",navFaq:"Info",bag:"Selection",heroEyebrow:"ORIGINAL MUSIC FOR CREATORS",heroTitle:"BGM for the stories you create.",heroText:"Original music for streams, videos, and virtual worlds. Find the sound that sets the scene.",heroArtTop:"SOUND STUDY / 001",heroArtBottom:"PERIVELLE · ORIGINAL BGM",browse:"Explore the catalog ↘",customCta:"Tell us your idea",portfolioEyebrow:"PORTFOLIO / SELECTED WORKS",portfolioTitle:"Sound for building worlds.",portfolioText:"Explore the concepts, moods, and details behind Perivelle music.",portfolioCard1:"Warm music for late-night streams.",portfolioCard2:"Soft piano with a rainy atmosphere.",portfolioCard3:"Cinematic music for a fantasy world.",portfolioView:"Explore the full portfolio",footerPortfolio:"View portfolio ↗",catalogEyebrow:"THE SOUND COLLECTION",catalogTitle:"Find your sound.",catalogText:"Browse by title, genre, and mood. Prices and details shown are sample data to customize.",searchPlaceholder:"Search title, genre, or mood",allMoods:"All moods",featured:"Featured",priceLow:"Lowest price",priceHigh:"Highest price",newest:"Newest",favoritesOnly:"♡ Favorites",customEyebrow:"MADE FOR YOUR WORLD",customTitle:"Have a sound in mind?",customText:"Tell us your concept, genre, vibe, and needs. This form prepares a brief on your device for you to send on Discord.",discordNote:"The Discord button copies your brief and opens Discord. Paste and send it yourself. Nothing is sent automatically.",nameLabel:"Name / stage name *",contactLabel:"Contact *",typeLabel:"Order type",originalSong:"Original song",other:"Other",genreLabel:"Desired genre *",vibeLabel:"Vibe / mood *",durationLabel:"Approximate duration",conceptLabel:"Music concept *",conceptHelp:"At least 20 characters. Do not include sensitive information.",conceptPlaceholder:"What is the music for? Describe the mood, instruments, and elements to include or avoid.",referenceLabel:"References (o