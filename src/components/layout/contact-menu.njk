var lang="en",cart=[],favorites=[],showFavorites=false,$=function(s){return document.querySelector(s)};
document.querySelectorAll("audio[data-preview]").forEach(function(a){var key=a.dataset.preview;if(AUDIO_PREVIEWS[key])a.src=AUDIO_PREVIEWS[key];else{a.controls=false;a.insertAdjacentText("afterend"," Preview is not available yet.")}});function readList(k){try{var v=JSON.parse(localStorage.getItem(k)||"[]");return Array.isArray(v)?v:[]}catch(e){return[]}}cart=readList("pv_cart").filter(function(id){return products.some(function(p){return p.id===id})});favorites=readList("pv_fav").filter(function(id){return products.some(function(p){return p.id===id})});function tr(k){return TXT[lang][k]||k}function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}function fmt(n){return lang==="id"?"Rp"+n.toLocaleString("id-ID"):"$"+(n/16000).toFixed(2)}function save(){try{localStorage.setItem("pv_cart",JSON.stringify(cart));localStorage.setItem("pv_fav",JSON.stringify(favorites))}catch(e){}}function moodName(m){return m}
