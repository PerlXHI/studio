function previewFrame(url){try{var u=new URL(String(url||""));if(u.protocol!=="https:")return "";var host=u.hostname.toLowerCase();if(host==="youtu.be"){var id=u.pathname.split("/").filter(Boolean)[0];return id?"https://www.youtube-nocookie.com/embed/"+encodeURIComponent(id)+"?rel=0&playsinline=1&iv_load_policy=3":""}if(["youtube.com","www.youtube.com","youtube-nocookie.com","www.youtube-nocookie.com"].includes(host)){if(u.pathname==="/watch"){var id=u.searchParams.get("v");return id?"https://www.youtube-nocookie.com/embed/"+encodeURIComponent(id):""}var m=u.pathname.match(/^\/(?:embed|shorts)\/([A-Za-z0-9_-]+)/);return m?"https://www.youtube-nocookie.com/embed/"+encodeURIComponent(m[1]):""}if(["vimeo.com","www.vimeo.com","player.vimeo.com"].includes(host)){var vid=u.pathname.split("/").filter(Boolean).pop();return vid&&/^\d+$/.test(vid)?"https://player.vimeo.com/video/"+vid:""}return ""}catch(e){return ""}}
function card(p){
 var embed=p.preview?previewFrame(p.preview):"";
